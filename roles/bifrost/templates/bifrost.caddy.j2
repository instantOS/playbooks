{{ bifrost_domain }} {
  encode zstd gzip

  request_body {
    max_size {{ bifrost_max_request_body_size_mb }}MB
  }

  header {
    -Server
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
  }

  reverse_proxy {{ bifrost_listen_address }}:{{ bifrost_port }}
}
